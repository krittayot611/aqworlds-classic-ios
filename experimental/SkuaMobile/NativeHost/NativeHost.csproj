<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AqwManagedHost</AssemblyName>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ProduceReferenceAssemblyInOutDir>true</ProduceReferenceAssemblyInOutDir>
    <SelfContained>true</SelfContained>
    <NativeLib>shared</NativeLib>
    <!-- Load assembly files directly; avoid the bundled-resource resolver seen in the startup crash. -->
    <BundlesResources>false</BundlesResources>
    <RunAOTCompilation>true</RunAOTCompilation>
    <ForceFullAOT>true</ForceFullAOT>
    <MonoForceInterpreter>false</MonoForceInterpreter>
    <UseMonoJustInterp>false</UseMonoJustInterp>
    <CustomRuntimeInitCallback>aqw_runtime_init</CustomRuntimeInitCallback>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TrimMode>copy</TrimMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep native exports while marking AOT images compatible with interpreter fallback. -->
    <MonoAOTCompilerDefaultAotArguments Include="interp" />
    <ProjectReference Include="../Runtime/Runtime.csproj" />
    <Compile Include="../Checks/BridgeChecks.cs" Link="BridgeChecks.cs" />
    <TrimmerRootDescriptor Include="Preserve.xml" />
  </ItemGroup>
  <Target Name="AddInterpreterRuntimeInitializer" BeforeTargets="_BuildNativeLibrary">
    <ItemGroup>
      <_ExtraLibrarySources Include="$(MSBuildThisFileDirectory)RuntimeInit.c" />
      <_ExtraLinkerArgs Include="-Wl,-exported_symbols_list,&quot;$(MSBuildThisFileDirectory)runtime-exports.txt&quot;" />
    </ItemGroup>
  </Target>
  <Target Name="StageNativeHostAssemblies" AfterTargets="_BuildNativeLibrary">
    <Copy SourceFiles="@(_AssembliesToBundleInternal)"
          DestinationFolder="$(MSBuildProjectDirectory)/obj/host-managed/$(RuntimeIdentifier)" />
  </Target>
</Project>
