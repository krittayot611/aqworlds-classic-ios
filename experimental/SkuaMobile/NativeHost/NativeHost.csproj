<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AqwManagedHost</AssemblyName>
    <SelfContained>true</SelfContained>
    <NativeLib>shared</NativeLib>
    <RunAOTCompilation>true</RunAOTCompilation>
    <ForceFullAOT>false</ForceFullAOT>
    <MonoForceInterpreter>true</MonoForceInterpreter>
    <UseMonoJustInterp>true</UseMonoJustInterp>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runtime/Runtime.csproj" />
    <Compile Include="../Checks/BridgeChecks.cs" Link="BridgeChecks.cs" />
    <TrimmerRootDescriptor Include="Preserve.xml" />
  </ItemGroup>
</Project>
