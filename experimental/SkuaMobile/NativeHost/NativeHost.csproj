<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AqwManagedHost</AssemblyName>
    <SelfContained>true</SelfContained>
    <NativeLib>shared</NativeLib>
    <RunAOTCompilation>true</RunAOTCompilation>
    <ForceFullAOT>true</ForceFullAOT>
    <MonoForceInterpreter>false</MonoForceInterpreter>
    <UseMonoJustInterp>false</UseMonoJustInterp>
    <CustomRuntimeInitCallback>aqw_runtime_init</CustomRuntimeInitCallback>
    <TrimMode>copy</TrimMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep native exports while marking AOT images compatible with interpreter fallback. -->
    <MonoAOTCompilerDefaultAotArguments Include="interp" />
    <ProjectReference Include="../Runtime/Runtime.csproj" />
    <Compile Include="../Checks/BridgeChecks.cs" Link="BridgeChecks.cs" />
    <TrimmerRootDescriptor Include="Preserve.xml" />
  </ItemGroup>
  <Target Name="AddInterpreterRuntimeInitializer" BeforeTargets="_BuildNativeLibrary">
    <ItemGroup>
      <_ExtraLibrarySources Include="$(MSBuildThisFileDirectory)RuntimeInit.c" />
    </ItemGroup>
  </Target>
</Project>
